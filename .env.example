# Tushare Pro API token (get free at https://tushare.pro)
TUSHARE_TOKEN=

# OpenAI API key (for LLM sentiment factor)
DEEPSEEK_API_KEY=

# Application settings
LOG_LEVEL=INFO

# Optional bearer token required for /api routes when set.
# NOTE: the browser UI does not send this token by default. If you enable it,
# build the frontend with VITE_QUANT_API_TOKEN set to the same value (the token
# is then part of the bundle) or terminate authentication at a reverse proxy.
QUANT_API_TOKEN=
