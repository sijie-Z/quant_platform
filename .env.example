# Tushare Pro API token (get free at https://tushare.pro)
TUSHARE_TOKEN=

# OpenAI API key (for LLM sentiment factor)
DEEPSEEK_API_KEY=

# Application settings
LOG_LEVEL=INFO

# Optional bearer token. When set, every /api route except /api/health
# requires it (Authorization: Bearer <token> or X-API-Key). Enter the same
# value in the UI's Settings page — it is kept in browser localStorage and is
# NOT baked into the frontend bundle.
# When unset, every /api route is loopback-only; remote access is refused.
# The shared token authenticates a consumer; it is NOT a tenant boundary.
# Tenant-scoped reads accept X-Tenant-Id / tenant_id and default to
# "default"; cross-tenant reads require all_tenants=true from loopback.
# WebSocket auth uses the `bearer.<token>` subprotocol; a token must be
# RFC 7230-safe (letters, digits, - . _ ~ and similar) because the legacy
# ?token= query transport was removed.
QUANT_API_TOKEN=

# Optional Host-header allowlist (comma separated): quant.example.com,
# *.corp.example.com. Unset = any syntactically valid host. Set this for
# proxy/ingress deployments; path-delimiter or malformed Hosts are always
# rejected before routing.
QUANT_ALLOWED_HOSTS=

# QMT trading password (env-only — never send a password in an API body).
QMT_PASSWORD=

