# Tushare Pro API token (get free at https://tushare.pro)
TUSHARE_TOKEN=

# OpenAI API key (for LLM sentiment factor)
DEEPSEEK_API_KEY=

# Application settings
LOG_LEVEL=INFO

# Optional bearer token. When set, every /api route except /api/health
# requires it (Authorization: Bearer <token> or X-API-Key). Enter the same
# value in the UI's Settings page — it is kept in browser localStorage and is
# NOT baked into the frontend bundle.
# When unset, every /api route is loopback-only; remote access is refused.
QUANT_API_TOKEN=
